<Window x:Class="VMixPlayerController.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centro de control" Width="850" Height="650" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <DataTemplate x:Key="ServiceChoiceTemplate">
            <TextBlock Text="{Binding Name}" Foreground="#FF000000"/>
        </DataTemplate>
        <DataTemplate x:Key="InputChoiceTemplate">
            <TextBlock Text="{Binding Title}" Foreground="#FF000000"/>
        </DataTemplate>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="TextElement.Foreground" Value="#FF000000"/>
            <Setter Property="Background" Value="#FFF4F7FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="CaretBrush" Value="#FF000000"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="TextElement.Foreground" Value="#FF000000"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FF000000" FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel Margin="3,0,0,12">
            <TextBlock Text="Centro de control" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Producción, salidas, datos y diagnóstico. Cada vMix habilitado se controla de forma independiente." Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <TabControl x:Name="ToolsTabs" Grid.Row="1" Background="{StaticResource CanvasBrush}">
            <TabItem Header="PRODUCCIÓN">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="CONTROLES PROTEGIDOS" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" FontSize="10"/>
                        <TextBlock Text="Se pedirá confirmación antes de iniciar o detener servicios de producción." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10"/>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Text="VMIX A" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProductionAStatus" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6"/>
                                <WrapPanel>
                                    <Button Content="GRABACIÓN" Tag="A|Recording" Click="Production_OnClick"/>
                                    <Button Content="STREAM" Tag="A|Streaming" Click="Production_OnClick"/>
                                    <Button Content="EXTERNAL" Tag="A|External" Click="Production_OnClick"/>
                                    <Button Content="MULTICORDER" Tag="A|MultiCorder" Click="Production_OnClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ProductionBPanel" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                            <StackPanel>
                                <TextBlock Text="VMIX B" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProductionBStatus" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6"/>
                                <WrapPanel>
                                    <Button Content="GRABACIÓN" Tag="B|Recording" Click="Production_OnClick"/>
                                    <Button Content="STREAM" Tag="B|Streaming" Click="Production_OnClick"/>
                                    <Button Content="EXTERNAL" Tag="B|External" Click="Production_OnClick"/>
                                    <Button Content="MULTICORDER" Tag="B|MultiCorder" Click="Production_OnClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SALIDAS">
                <StackPanel Margin="14" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="ROUTER DE OUTPUTS" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Outputs 2–4 dependen de la edición de vMix. La opción se mantiene separada de los players para evitar cambios accidentales." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                    <TextBlock Text="vMix" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="OutputServiceSelector" ItemTemplate="{StaticResource ServiceChoiceTemplate}"/>
                    <TextBlock Text="Output" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                    <ComboBox x:Name="OutputNumberSelector">
                        <ComboBoxItem Tag="2"><TextBlock Text="Output 2" Foreground="#FF000000"/></ComboBoxItem>
                        <ComboBoxItem Tag="3"><TextBlock Text="Output 3" Foreground="#FF000000"/></ComboBoxItem>
                        <ComboBoxItem Tag="4"><TextBlock Text="Output 4" Foreground="#FF000000"/></ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Fuente" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                    <ComboBox x:Name="OutputSourceSelector">
                        <ComboBoxItem Tag="Output"><TextBlock Text="Output principal" Foreground="#FF000000"/></ComboBoxItem>
                        <ComboBoxItem Tag="Preview"><TextBlock Text="Preview" Foreground="#FF000000"/></ComboBoxItem>
                        <ComboBoxItem Tag="MultiView"><TextBlock Text="MultiView" Foreground="#FF000000"/></ComboBoxItem>
                        <ComboBoxItem Tag="Replay"><TextBlock Text="Replay" Foreground="#FF000000"/></ComboBoxItem>
                        <ComboBoxItem Tag="Mix"><TextBlock Text="Mix" Foreground="#FF000000"/></ComboBoxItem>
                        <ComboBoxItem Tag="Input"><TextBlock Text="Input" Foreground="#FF000000"/></ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Número de Input o Mix (cuando corresponda)" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                    <TextBox x:Name="OutputInputValue" Text="1"/>
                    <Button Content="APLICAR RUTA" Click="ApplyOutput_OnClick" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="3,12,3,3"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="DATOS">
                <StackPanel Margin="14" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="FUENTES DE DATOS PARA TÍTULOS" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Controla filas de Excel, CSV, XML o Google Sheets ya configuradas dentro de vMix." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                    <ComboBox x:Name="DataServiceSelector" ItemTemplate="{StaticResource ServiceChoiceTemplate}"/>
                    <TextBox x:Name="GlobalDataSource" ToolTip="Nombre de la fuente"/>
                    <TextBox x:Name="GlobalDataTable" ToolTip="Tabla u hoja"/>
                    <WrapPanel>
                        <Button Content="◀ FILA" Tag="DataSourcePreviousRow" Click="GlobalData_OnClick"/>
                        <Button Content="FILA ▶" Tag="DataSourceNextRow" Click="GlobalData_OnClick"/>
                        <TextBox x:Name="GlobalDataRow" Text="0" Width="65" ToolTip="Índice de fila, empezando en 0"/>
                        <Button Content="SELECCIONAR" Tag="DataSourceSelectRow" Click="GlobalData_OnClick"/>
                        <ToggleButton x:Name="DataAutoNextToggle" Content="AUTO NEXT" Click="DataAutoNext_OnClick"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="AUDIO">
                <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="AUDIO ASOCIADO AL INPUT" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Control ligero para el input seleccionado; no pretende sustituir el mezclador de audio de vMix." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                    <ComboBox x:Name="AudioServiceSelector" ItemTemplate="{StaticResource ServiceChoiceTemplate}" SelectionChanged="AudioService_OnSelectionChanged"/>
                    <ComboBox x:Name="AudioInputSelector" ItemTemplate="{StaticResource InputChoiceTemplate}"/>
                    <WrapPanel>
                        <Button Content="AUDIO ON" Tag="AudioOn" Click="AudioCommand_OnClick"/>
                        <Button Content="AUDIO OFF" Tag="AudioOff" Click="AudioCommand_OnClick"/>
                        <Button Content="AUDIO AUTO" Tag="AudioAuto" Click="AudioCommand_OnClick"/>
                    </WrapPanel>
                    <TextBlock Text="Volumen 0–100" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" Width="360"/>
                        <Button Content="APLICAR" Click="Volume_OnClick"/>
                    </StackPanel>
                    <TextBlock Text="Bus" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    <WrapPanel>
                        <ComboBox x:Name="AudioBusSelector" Width="95">
                            <ComboBoxItem Tag="M"><TextBlock Text="Master" Foreground="#FF000000"/></ComboBoxItem>
                            <ComboBoxItem Tag="A"><TextBlock Text="A" Foreground="#FF000000"/></ComboBoxItem>
                            <ComboBoxItem Tag="B"><TextBlock Text="B" Foreground="#FF000000"/></ComboBoxItem>
                            <ComboBoxItem Tag="C"><TextBlock Text="C" Foreground="#FF000000"/></ComboBoxItem>
                            <ComboBoxItem Tag="D"><TextBlock Text="D" Foreground="#FF000000"/></ComboBoxItem>
                            <ComboBoxItem Tag="E"><TextBlock Text="E" Foreground="#FF000000"/></ComboBoxItem>
                            <ComboBoxItem Tag="F"><TextBlock Text="F" Foreground="#FF000000"/></ComboBoxItem>
                            <ComboBoxItem Tag="G"><TextBlock Text="G" Foreground="#FF000000"/></ComboBoxItem>
                        </ComboBox>
                        <Button Content="BUS ON" Tag="On" Click="AudioBus_OnClick"/>
                        <Button Content="BUS OFF" Tag="Off" Click="AudioBus_OnClick"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="PRESETS">
                <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="PRESETS DE VMIX" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="La ruta pertenece al ordenador donde se ejecuta vMix. Abrir un preset cambia la producción completa, por eso requiere confirmación." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                    <ComboBox x:Name="PresetServiceSelector" ItemTemplate="{StaticResource ServiceChoiceTemplate}"/>
                    <TextBox x:Name="PresetPath" Text="C:\Produccion\programa.vmix"/>
                    <WrapPanel>
                        <Button Content="GUARDAR PRESET" Tag="SavePreset" Click="Preset_OnClick"/>
                        <Button Content="ABRIR PRESET" Tag="OpenPreset" Click="Preset_OnClick" Style="{StaticResource DangerButton}"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="DIAGNÓSTICO">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="REGISTRO LOCAL" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="No se envía telemetría a Internet. El paquete de soporte solo se crea cuando tú lo solicitas." Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="0,10"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="ACTUALIZAR" Click="RefreshLog_OnClick"/>
                        <Button Content="EXPORTAR DIAGNÓSTICO" Click="ExportDiagnostic_OnClick" Style="{StaticResource AccentButton}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
