<Window x:Class="VMixPlayerController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vMix Player Controller" MinWidth="1180" MinHeight="720"
        WindowState="Maximized" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="vMix Player Controller" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="by santosmanilva" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF0C121A" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="3">
                        <StackPanel>
                            <TextBlock Text="VMIX A" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="3,0,3,3"/>
                            <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
                                <Ellipse x:Name="StatusADot" Width="7" Height="7" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusAText" Text="DESCONECTADO" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,8,0"/>
                                <TextBlock x:Name="ProductionAText" Text="REC ○  STR ○  EXT ○" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#FF0C121A" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="3">
                        <StackPanel>
                            <TextBlock Text="VMIX B" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="3,0,3,3"/>
                            <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
                                <Ellipse x:Name="StatusBDot" Width="7" Height="7" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusBText" Text="DESCONECTADO" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,8,0"/>
                                <TextBlock x:Name="ProductionBText" Text="REC ○  STR ○  EXT ○" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FF0C121A" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="3">
                        <StackPanel>
                            <TextBlock Text="ATEM" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="3,0,3,3"/>
                            <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
                                <Ellipse x:Name="AtemStatusDot" Width="7" Height="7" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AtemStatusText" Text="DESCONECTADA" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="CONECTAR" Click="Connect_OnClick" Style="{StaticResource AccentButton}"/>
                    <Button Content="CONFIGURACIÓN" Click="Settings_OnClick"/>
                    <Button Content="HERRAMIENTAS" Click="Tools_OnClick"/>
                    <Button Content="PERFIL" Click="Profile_OnClick"/>
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PlayersScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="8">
            <Grid MinWidth="1420" Width="{Binding ViewportWidth, ElementName=PlayersScroller}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:PlayerControl x:Name="Player1" Grid.Column="0" xmlns:local="clr-namespace:VMixPlayerController"/>
                <local:PlayerControl x:Name="Player2" Grid.Column="1" xmlns:local="clr-namespace:VMixPlayerController"/>
                <local:PlayerControl x:Name="Player3" Grid.Column="2" xmlns:local="clr-namespace:VMixPlayerController"/>
                <local:PlayerControl x:Name="Player4" Grid.Column="3" xmlns:local="clr-namespace:VMixPlayerController"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FF070A0F" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LastActionText" Text="Preparado" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                <TextBlock Grid.Column="1" Text="F1–F4: GO  ·  ESPACIO: PLAY/PAUSA DEL PLAYER ACTIVO" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
            </Grid>
        </Border>
    </Grid>
</Window>
