<Window x:Class="VMixPlayerController.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Width="620" Height="520" MinWidth="560" MinHeight="470"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="TextElement.Foreground" Value="#FF000000"/>
            <Setter Property="Background" Value="#FFF4F7FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="CaretBrush" Value="#FF000000"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="3"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF000000"/>
                    <Setter Property="TextElement.Foreground" Value="#FF000000"/>
                    <Setter Property="Background" Value="#FFD9E1E8"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="CONFIGURACIÓN DE EQUIPOS" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Estas direcciones se guardan en el perfil local del programa."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <TextBlock Text="vMix A" FontWeight="SemiBold" Margin="3,0,0,5"/>
                    <TextBlock Grid.Column="1" Text="PUERTO HTTP" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="3,0,0,5"/>
                    <TextBox x:Name="VmixAHostBox" Grid.Row="1" ToolTip="IP o nombre del equipo vMix A"/>
                    <TextBox x:Name="VmixAPortBox" Grid.Row="1" Grid.Column="1" ToolTip="Puerto de la API HTTP de vMix"/>
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <Grid x:Name="VmixBFieldsPanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="UseVmixBCheck" Content="Usar vMix B" FontWeight="SemiBold" Margin="3,0,0,5"
                              Checked="UseVmixBCheck_OnChanged" Unchecked="UseVmixBCheck_OnChanged"/>
                    <TextBlock Grid.Column="1" Text="PUERTO HTTP" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="3,0,0,5"/>
                    <TextBox x:Name="VmixBHostBox" Grid.Row="1" ToolTip="IP o nombre del equipo vMix B"/>
                    <TextBox x:Name="VmixBPortBox" Grid.Row="1" Grid.Column="1" ToolTip="Puerto de la API HTTP de vMix"/>
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="ATEM Constellation" FontWeight="SemiBold" Margin="3,0,0,5"/>
                    <TextBox x:Name="AtemHostBox" ToolTip="Dirección IP de la ATEM"/>
                    <TextBlock Text="La conexión ATEM solo vigila el estado PGM; no modifica la mesa."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="3,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="AutoConnectCheck" Content="Conectar automáticamente al abrir" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="CANCELAR" Click="Cancel_OnClick"/>
                <Button Content="GUARDAR Y CONECTAR" Click="Save_OnClick" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
